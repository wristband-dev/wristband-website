---
// Emitted as dist/404.html. With this file present, Cloudflare Pages answers unknown URLs
// with a real 404 instead of serving the home page with a 200 (single-page-app fallback).
// That fallback made /.well-known/ai-catalog.json return HTML, which Lighthouse's Agentic
// Browsing check reported as an invalid ARD manifest.
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
---

<BaseLayout title="Page not found | Wristband" description="The page you are looking for does not exist." noIndex>
  <section class="not-found">
    <div class="not-found__container">
      <div class="not-found__inner">
        <h1 class="not-found__title">Page not found</h1>
        <div class="not-found__text-wrap">
          <p class="not-found__text">The page you are looking for does not exist or has moved.</p>
        </div>
        <div class="not-found__action">
          <ButtonLink href="/" label="Back to home" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Bottom padding gives the same space above the footer as the team and policy pages. */
  .not-found {
    margin: 0 10px 20px;
    padding-top: 100px;
    padding-bottom: 80px;
    background-color: var(--color-bg);
    text-align: center;
  }

  .not-found__container {
    margin-left: 20px;
    margin-right: 20px;
  }

  .not-found__inner {
    max-width: 1020px;
    margin-left: auto;
    margin-right: auto;
  }

  .not-found__title {
    color: var(--color-text);
  }

  /* A column that shrinks to the text's width, like Webflow's centered 600px container. */
  .not-found__text-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .not-found__text {
    color: var(--color-text-subtle);
  }

  .not-found__action {
    margin-top: 80px;
  }

  @media screen and (max-width: 991px) {
    .not-found {
      padding-top: 80px;
    }

    .not-found__action {
      margin-top: 64px;
    }
  }

  @media screen and (max-width: 767px) {
    .not-found {
      padding-top: 56px;
      padding-bottom: 60px;
    }

    .not-found__action {
      margin-top: 40px;
    }
  }

  @media screen and (max-width: 479px) {
    /* Webflow's header adds 60px of space below itself at this width. */
    .not-found {
      margin-top: 60px;
    }

    .not-found__container {
      margin-left: 16px;
      margin-right: 16px;
    }
  }
</style>
