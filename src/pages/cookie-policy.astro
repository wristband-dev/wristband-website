---
// Cookie Policy page, rebuilt without Webflow. The policy text comes from Termly's embed.
import BaseLayout from '../layouts/BaseLayout.astro';
import TermlyPolicy from '../components/TermlyPolicy.astro';
---

<BaseLayout
  title="Cookie Policy"
  description="Learn how Wristband uses cookies to enhance your browsing experience, analyze site traffic, and improve our authentication services."
  termlyPolicyEmbed
>
  <h1 class="visually-hidden">Cookie Policy</h1>
  <TermlyPolicy embedId="fb5d39cd-f730-4f10-8e16-c7c9f9e338aa" consentLink />
</BaseLayout>

<style>
  /* Hidden on screen, since Termly shows its own title, but read by search engines and screen readers. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
