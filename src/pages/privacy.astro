---
// Privacy Policy page, rebuilt without Webflow. The policy text comes from Termly's embed.
import BaseLayout from '../layouts/BaseLayout.astro';
import TermlyPolicy from '../components/TermlyPolicy.astro';
---

<BaseLayout
  title="Privacy Policy - Wristband"
  description="Read Wristband's Privacy Policy to understand how we collect, use, and protect your personal information and data."
  ogImage="/images/hero_background.webp"
  termlyPolicyEmbed
>
  <h1 class="visually-hidden">Privacy Policy</h1>
  <TermlyPolicy embedId="cfc3821a-78f5-40f5-8958-00918ec85390" />
</BaseLayout>

<style>
  /* Hidden on screen, since Termly shows its own title, but read by search engines and screen readers. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
