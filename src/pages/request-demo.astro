---
import WebflowLayout from '../layouts/WebflowLayout.astro';
import { getWebflowMeta } from '../lib/webflow';
import bodyHtml from '../webflow/request-demo.html?raw';

const meta = getWebflowMeta('request-demo');
---

<WebflowLayout
  title={meta.title}
  description={meta.description || undefined}
  ogImage={meta.ogImage || undefined}
  wfPage={meta.wfPage}
  wfSite={meta.wfSite}
  bodyClass={meta.bodyClass}
>
  <Fragment set:html={bodyHtml} />

  <script>
    // Submit with fetch (the endpoint answers JSON) and show the Webflow success / fail state in place.
    type DataLayerWindow = Window & { dataLayer?: Record<string, unknown>[] };

    const form = document.querySelector<HTMLFormElement>('#wf-form-request-demo');
    const formWrap = form?.closest('.w-form');
    const done = formWrap?.querySelector<HTMLElement>('.w-form-done');
    const fail = formWrap?.querySelector<HTMLElement>('.w-form-fail');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLInputElement>('input[type="submit"]');
      const label = button?.value ?? '';
      if (button) {
        button.disabled = true;
        button.value = button.dataset.wait || label;
      }
      if (fail) fail.style.display = 'none';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email: new FormData(form).get('email') }),
        });
        const data = (await res.json().catch(() => null)) as { ok?: boolean } | null;
        if (!res.ok || !data?.ok) throw new Error(`Demo form request failed (${res.status})`);

        form.style.display = 'none';
        if (done) {
          done.style.display = 'block';
          done.focus();
        }
        const win = window as DataLayerWindow;
        win.dataLayer = win.dataLayer || [];
        win.dataLayer.push({ event: 'generate_lead', lead_type: 'demo_form' });
      } catch {
        if (fail) {
          fail.style.display = 'block';
          fail.focus();
        }
      } finally {
        if (button) {
          button.disabled = false;
          button.value = label;
        }
      }
    });
  </script>
</WebflowLayout>
