  }

  .benefit__text {
    display: flex;
    flex: 1;
    flex-flow: column;
    align-items: stretch;
  }

  .benefit__text-inner {
    display: flex;
    flex-flow: column;
    align-items: flex-start;
  }

  .benefit__eyebrow {
    color: #3882d2;
    font-size: 18px;
    font-weight: var(--font-weight-bold);
    line-height: 70px;
    letter-spacing: 1px;
    text-shadow: 0 1px 1px #00000080;
  }

  .benefit__title {
    margin-bottom: 33px;
    color: var(--palette-white-smoke);
    font-size: 40px;
    font-weight: var(--font-weight-semibold);
  }

  .benefit__description {
    color: var(--palette-white-smoke);
    font-size: 17px;
    line-height: 25px;
  }

  .benefit__list {
    margin-bottom: 33px;
    color: var(--palette-white-smoke);
    font-size: 17px;
    line-height: 25px;
  }

  .benefit__link {
    border-bottom: 1px solid transparent;
    color: var(--palette-aquamarine);
    font-size: 17px;
    line-height: 25px;
    text-decoration: none;
