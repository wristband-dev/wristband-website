  }

  .slack-button__label:hover {
    color: #0c0c0c;
  }

  .slack-button__logo {
    display: flex;
  }

  /* Testimonials */
  .testimonials-section {
    padding-top: 60px;
    padding-bottom: 60px;
  }

  .testimonials-section__heading {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 56px;
  }

  .testimonials-section__title {
    flex: none;
    margin-top: 10px;
    margin-bottom: 10px;
    color: var(--palette-charcoal);
    font-size: 44px;
    font-weight: var(--font-weight-regular);
    text-align: center;
  }

  .featured {
    position: relative;
    display: flex;
    width: 90%;
    max-width: 1400px;
    margin: 0 auto 80px;
  }

  .featured__quote {
    width: 100%;
