  /* Slack */
  .dark__title--slack {
    margin-bottom: 24px;
  }

  .slack-button {
    min-width: 160px;
    padding: 16px 20px;
    border: 2px solid var(--palette-white-smoke);
    border-radius: var(--radius-12);
    background-color: transparent;
    color: var(--palette-white-smoke);
    font-weight: var(--font-weight-bold);
    line-height: 20px;
    text-decoration: none;
    cursor: pointer;
    transform-style: preserve-3d;
    box-shadow: 0 4px 10px #14142b0a;
    transition:
      box-shadow 0.3s,
      background-color 0.3s,
      transform 0.3s,
      color 0.3s;
  }

  .slack-button:hover {
    border-color: var(--palette-charcoal);
