---
import WebflowLayout from '../layouts/WebflowLayout.astro';
import SdkMatrix from '../components/SdkMatrix.astro';
import { getWebflowMeta } from '../lib/webflow';
import { softwareApplicationNode } from '../lib/seo';
import bodyHtml from '../webflow/home.html?raw';

const meta = getWebflowMeta('home');
---

<WebflowLayout
  title={meta.title}
  description={meta.description || undefined}
  ogImage={meta.ogImage || undefined}
  jsonLd={[softwareApplicationNode()]}
  wfPage={meta.wfPage}
  wfSite={meta.wfSite}
  bodyClass={meta.bodyClass}
>
  <!-- The hero background is a CSS background-image, so without a preload the browser
       only finds it after webflow.css is parsed. On phones it is the LCP element. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    fetchpriority="high"
    media="(max-width: 479px)"
    href="/images/misc/67cca2a2c5839fca18c84583_hero-background-conic-gradient.svg"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    fetchpriority="high"
    media="(min-width: 480px)"
    href="/images/misc/67e63012d18f7f9092cdd846_hero-background-linear-grad-adjusted-2.svg"
  />
  <Fragment set:html={bodyHtml} />
  <SdkMatrix />
</WebflowLayout>
