---
// One page per blog post in src/content/blog, rendered with BlogArticleLayout.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogArticleLayout from '../../layouts/BlogArticleLayout.astro';
import { SITE } from '../../lib/constants';
import { blogPostingNode, breadcrumbNode, pagePath } from '../../lib/seo';
import { AUTHORS, type Author } from '../../data/blog/authors';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const canonical = new URL(pagePath(Astro.url.pathname), Astro.site ?? SITE.url).href;

// The post's author from src/data/blog/authors.ts, if its frontmatter has an authorId.
function postAuthor(entry: CollectionEntry<'blog'>): Author | undefined {
  const { authorId } = entry.data;
  if (!authorId) return undefined;
  if (!(authorId in AUTHORS)) {
    throw new Error(`Unknown authorId "${authorId}" in blog post "${entry.id}" (see src/data/blog/authors.ts)`);
  }
  return AUTHORS[authorId as keyof typeof AUTHORS];
}

const author = postAuthor(post);
const { coverImage } = post.data;
const ogImage = coverImage.startsWith('http') ? coverImage : new URL(coverImage, Astro.site ?? SITE.url).href;

const jsonLd = [
  blogPostingNode({
    url: canonical,
    headline: post.data.title,
    description: post.data.summary || undefined,
    image: coverImage,
    datePublished: post.data.datePublished,
    dateModified: post.data.dateModified,
    authorName: post.data.author,
    authorPerson: author && {
      name: author.name,
      url: author.profileUrl,
      sameAs: author.linkedin ? [author.linkedin] : undefined,
    },
  }),
  breadcrumbNode([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: post.data.title, path: pagePath(Astro.url.pathname) },
  ]),
];
---

<BlogArticleLayout
  title={post.data.title}
  summary={post.data.summary}
  category={post.data.category}
  cover={post.data.cover ?? coverImage}
  ogImage={ogImage}
  datePublished={post.data.datePublished}
  jsonLd={jsonLd}
  author={author}
>
  <Content />
</BlogArticleLayout>
