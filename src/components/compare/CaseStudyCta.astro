---
// Dark case study section used on competitor pages: a title, a customer quote with photo,
// a short description and a button. Matches Webflow's .auth0-competitor-case-study-cta.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  /** The quote, split so the highlighted words can be colored: before, highlight, after. */
  quote: { before: string; highlight: string; after: string };
  author: { name: string; role: string; photo: ImageMetadata };
  description: string;
  cta: { label: string; href: string };
}

const { title, quote, author, description, cta } = Astro.props;

// Built as one string so no spaces get added between the quote marks, the text and the highlight.
const escape = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const quoteHtml =
  `<span class="case-study__mark case-study__mark--open">“</span>${escape(quote.before)}` +
  `<span class="case-study__highlight">${escape(quote.highlight)}</span>${escape(quote.after)}` +
  `<span class="case-study__mark case-study__mark--close">”</span>`;
---

<section class="case-study">
  <div class="case-study__inner">
    <h2 class="case-study__title">{title}</h2>
    <figure class="case-study__quote">
      <blockquote class="case-study__quote-text" set:html={quoteHtml} />
      <figcaption class="case-study__author">
        <div class="case-study__author-text">
          <span class="case-study__author-name">{author.name}</span>
          <br />
          {author.role}
        </div>
        <div class="case-study__photo">
          <Image src={author.photo} alt={author.name} widths={[68, 136]} sizes="68px" loading="lazy" />
        </div>
      </figcaption>
    </figure>
    <p class="case-study__description">{description}</p>
    {/* The reveal is on a wrapper so its transition does not slow down the button's hover colors. */}
    <div class="case-study__cta-wrap" data-reveal>
      <a href={cta.href} class="case-study__cta">
        {cta.label}
      </a>
    </div>
  </div>
</section>

<style>
  .case-study {
    padding: 80px 20px;
    background-color: var(--palette-dark-gray);
  }

  .case-study__inner {
    display: flex;
    flex-flow: column;
    align-items: center;
    gap: 16px;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Was an h1 on live Webflow; now an h2 with the same look. */
  .case-study__title {
    margin-bottom: 20px;
    color: var(--palette-white-smoke);
    font-size: 48px;
    line-height: var(--line-height-h1);
    text-align: center;
  }

  .case-study__quote {
    max-width: 800px;
    margin: 0 auto 20px;
    padding: 20px 20px 15px;
    border: 1px solid var(--palette-pink);
    border-radius: var(--radius-16);
  }

  .case-study__quote-text {
    max-width: 90%;
    margin: 0 auto 10px;
    padding: 0;
    color: var(--palette-white);
    font-family: var(--font-sans);
    font-weight: var(--font-weight-semibold);
    line-height: 1.8em;
  }

  .case-study__quote-text :global(.case-study__mark) {
    color: var(--palette-white);
    font-size: 24px;
    font-weight: var(--font-weight-semibold);
  }

  .case-study__quote-text :global(.case-study__mark--open) {
    padding-right: 5px;
  }

  .case-study__quote-text :global(.case-study__mark--close) {
    padding-left: 3px;
  }

  .case-study__quote-text :global(.case-study__highlight) {
    color: var(--color-brand-bright);
    font-weight: var(--font-weight-medium);
  }

  .case-study__author {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    max-width: 90%;
    margin-left: auto;
    margin-right: auto;
  }

  .case-study__author-text {
    width: 100%;
    padding-right: 20px;
    color: var(--palette-white);
    font-size: 16px;
    font-style: italic;
    line-height: 1.4em;
    text-align: right;
  }

  .case-study__author-name {
    color: var(--palette-white);
    font-size: 16px;
    font-style: normal;
    font-weight: var(--font-weight-semibold);
  }

  .case-study__photo {
    width: 68px;
    min-width: 68px;
    height: 68px;
    min-height: 68px;
    margin-left: auto;
    overflow: hidden;
    border-radius: 1000px;
    transform: translate(0);
  }

  /* Astro sets the original size (800x800) as width and height; let CSS size it to the circle. */
  .case-study__photo img {
    height: auto;
  }

  .case-study__description {
    max-width: 700px;
    color: var(--palette-white);
    font-weight: 300;
    text-align: center;
  }

  .case-study__cta {
    display: inline-block;
    padding: 16px 32px;
    border: 2px solid transparent;
    border-radius: var(--radius-12);
    background-color: var(--palette-pink);
    color: var(--palette-white);
    font-size: 16px;
    font-weight: var(--font-weight-medium);
    line-height: 18px;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.3s,
      background-color 0.3s,
      box-shadow 0.3s,
      transform 0.3s,
      color 0.3s;
  }

  /* Webflow's CSS also shrinks the button on hover, but its scroll animation overrides that on live,
     so live does not shrink. Matching live. */
  .case-study__cta:hover {
    border-color: var(--palette-pink);
    background-color: var(--palette-charcoal);
    color: var(--palette-pink);
  }

  @media screen and (max-width: 991px) {
    .case-study__inner {
      padding-left: 24px;
      padding-right: 24px;
    }

    .case-study__quote {
      padding-left: 10px;
      padding-right: 10px;
    }

    .case-study__author-name {
      font-size: 15px;
    }
  }

  @media screen and (max-width: 767px) {
    .case-study__quote-text {
      font-size: 17px;
    }

    .case-study__photo {
      width: 65px;
      min-width: 65px;
      height: 65px;
      min-height: 65px;
    }
  }

  @media screen and (max-width: 479px) {
    .case-study__author-text {
      max-width: 300px;
      padding-right: 10px;
    }

    .case-study__cta-wrap {
      width: 100%;
    }

    .case-study__cta {
      width: 100%;
      margin-bottom: 10px;
      padding: 12px 20px;
    }
  }
</style>
