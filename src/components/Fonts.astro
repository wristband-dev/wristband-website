---
// Self-hosted copies of the Google Fonts the Webflow export uses (latin and latin-ext
// subsets, from fonts.googleapis.com css2). Serving them from this origin removes two
// render-blocking stylesheet requests to fonts.googleapis.com and the extra connection
// to fonts.gstatic.com. All four are variable fonts, so one file covers every weight.
const LATIN =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
const LATIN_EXT =
  'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF';

const families = [
  { family: 'Inter', file: 'inter-v20', display: 'swap' },
  { family: 'JetBrains Mono', file: 'jetbrains-mono-v24', display: 'swap' },
  // Not used by the site's own CSS: the Termly cookie banner's theme font. "optional" stops
  // the banner re-flowing when the font arrives after it renders (a 0.14 CLS hit on mobile);
  // the font is still fetched and cached, so later page views get Roboto.
  { family: 'Roboto', file: 'roboto-v51', display: 'optional' },
];

const fontFaces = families
  .flatMap(({ family, file, display }) => [
    { family, display, src: `/fonts/${file}-latin-ext.woff2`, range: LATIN_EXT },
    { family, display, src: `/fonts/${file}-latin.woff2`, range: LATIN },
  ])
  .map(
    ({ family, display, src, range }) =>
      `@font-face{font-family:'${family}';font-style:normal;font-weight:300 700;font-display:${display};src:url(${src}) format('woff2');unicode-range:${range}}`,
  )
  .join('\n');

// Material Icons draws the FAQ accordion chevrons from ligatures (keyboard_arrow_down);
// display:block keeps the ligature text hidden until the font arrives.
const iconFace = `@font-face{font-family:'Material Icons';font-style:normal;font-weight:400;font-display:block;src:url(/fonts/material-icons-v145.woff2) format('woff2')}`;
---

<link rel="preload" href="/fonts/inter-v20-latin.woff2" as="font" type="font/woff2" crossorigin />
<style is:inline set:html={`${fontFaces}\n${iconFace}`} />
