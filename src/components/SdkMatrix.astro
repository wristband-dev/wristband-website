---
import { codeToHtml } from 'shiki';
import { ENDPOINT_IDS, SDK_FRAMEWORKS } from '../data/sdk-matrix';
import SdkMatrixWidget, { type HighlightedFramework } from './react/SdkMatrix';

const frameworks: HighlightedFramework[] = await Promise.all(
  SDK_FRAMEWORKS.map(async (framework) => {
    const samples = {} as HighlightedFramework['samples'];
    for (const id of ENDPOINT_IDS) {
      const sample = framework.samples[id];
      samples[id] = {
        ...sample,
        html: await codeToHtml(sample.code.trimEnd(), {
          lang: sample.language,
          theme: 'night-owl',
        }),
      };
    }
    return { id: framework.id, name: framework.name, samples };
  }),
);
---

<SdkMatrixWidget client:load frameworks={frameworks} />

<style is:global>
  #wristband-sdk-matrix {
    width: 100%;
  }
</style>
