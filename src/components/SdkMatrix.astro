---
import { codeToHtml } from 'shiki';
import { ENDPOINT_IDS, SDK_FRAMEWORKS } from '../data/sdk-matrix';
import SdkMatrix, { type HighlightedFramework } from './react/SdkMatrix';

const frameworks: HighlightedFramework[] = await Promise.all(
  SDK_FRAMEWORKS.map(async (framework) => {
    const samples = {} as HighlightedFramework['samples'];
    for (const id of ENDPOINT_IDS) {
      const sample = framework.samples[id];
      samples[id] = {
        ...sample,
        html: await codeToHtml(sample.code.trimEnd(), {
          lang: sample.language,
          theme: 'night-owl',
        }),
      };
    }
    return { id: framework.id, name: framework.name, samples };
  }),
);
---

{/* 1. Astro outputs this on the server side into the source code for perfect SEO ranking */}
<div id="seo-matrix-source">
  <SdkMatrix client:load frameworks={frameworks} />
</div>

{/* 2. This tiny vanilla client script relocates the element cleanly on page bootup */}
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const target = document.getElementById('wristband-sdk-matrix');
    const source = document.getElementById('seo-matrix-source');
    
    if (target && source) {
      // Teleports the built DOM element directly into Webflow's layout target
      target.appendChild(source);
    }
  });
</script>

<style>
  #seo-matrix-source {
    width: 100%;
  }
</style>
