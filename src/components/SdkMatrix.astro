---
/**
 * Mounts the existing Wristband SDK matrix widget.
 * Script remains on assets.wristband.dev until R2 cutover.
 */
---

<section class="section" id="sdk-matrix-section">
  <div class="container">
    <div class="section-header" style="text-align:center;margin-bottom:32px;">
      <p class="eyebrow">How To Integrate</p>
      <h2 class="section-title">Use Our Developer Friendly SDKs</h2>
    </div>
    <div id="wristband-sdk-matrix"></div>
  </div>
</section>

<script is:inline src="https://assets.wristband.dev/sdk-matrix/wristband-sdk-matrix.js"></script>
