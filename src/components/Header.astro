---
// Site header for rebuilt pages. Matches the header on live Webflow. Sizes, spacing and breakpoints come from webflow.css.
// Dark pages (home and the Thoughtly case study) get the white logo and light desktop links.
// The open mobile menu stays light on every page, like live Webflow, with larger links on dark pages.
import { Image } from 'astro:assets';
import logo from '../assets/brand/wristband-logo.svg';
import logoWhite from '../assets/brand/wristband-logo-white.svg';
import { LINKS } from '../lib/constants';

interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;

const DOCS_URL = 'https://docs.wristband.dev/docs/getting-started';

const navLinks = [
  { label: 'Docs', href: DOCS_URL, external: true },
  { label: 'Blog', href: '/blog', external: false },
  { label: 'Pricing', href: '/pricing', external: false },
  { label: 'Status', href: LINKS.status, external: true },
];
---

<header class:list={['site-header', theme === 'dark' && 'site-header--dark']} data-site-header>
  <div class="site-header__container">
    <div class="site-header__wrapper">
      <a href="/" class="site-header__logo">
        <Image src={theme === 'dark' ? logoWhite : logo} alt="Wristband" width={220} height={48} loading="eager" />
      </a>

      <nav class="site-header__menu" id="site-header-menu" aria-label="Main">
        <ul class="site-header__links" role="list">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="site-header__link"
                {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="site-header__menu-actions">
          <a href={LINKS.login} class="site-header__menu-login">
            Log In
          </a>
          <a href={LINKS.signup} class="site-header__menu-signup">
            Sign Up
          </a>
        </div>
      </nav>

      <div class="site-header__right">
        <div class="site-header__actions">
          <a href={LINKS.login} class="site-header__login">
            Login
          </a>
          <a href={LINKS.signup} class="site-header__signup">
            Sign Up
          </a>
        </div>
        <button
          type="button"
          class="site-header__menu-button"
          aria-controls="site-header-menu"
          aria-expanded="false"
          aria-label="Open menu"
        >
          <span class="site-header__menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // Opens and closes the mobile menu (991px and below). Replaces Webflow's nav script.
  const DESKTOP_QUERY = window.matchMedia('(min-width: 992px)');

  for (const header of document.querySelectorAll<HTMLElement>('[data-site-header]')) {
    const button = header.querySelector<HTMLButtonElement>('.site-header__menu-button');
    const menu = header.querySelector<HTMLElement>('.site-header__menu');
    if (!button || !menu) continue;

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      // Like Webflow, the open menu covers the whole page, not just the screen.
      menu.style.height = open ? `${document.documentElement.scrollHeight}px` : '';
    };

    button.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        button.focus();
      }
    });
    DESKTOP_QUERY.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 1000;
    width: 100%;
    /* The closed mobile menu sits off-screen to the right; clip it so the page cannot scroll sideways. */
    overflow-x: clip;
    padding-top: 32px;
    padding-bottom: 32px;
    background-color: transparent;
  }

  .site-header__container {
    max-width: var(--container-header-max);
    margin-left: 20px;
    margin-right: 20px;
  }

  .site-header__wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-left: 1.666vw;
    margin-right: 1.666vw;
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    transform-style: preserve-3d;
    transition: transform 0.35s;
  }

  .site-header__logo:hover {
    transform: scale3d(0.94, 0.94, 0.05);
  }

  .site-header__logo img {
    max-width: 220px;
    min-height: 36px;
    max-height: 52px;
  }

  .site-header__links {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__link {
    display: inline-block;
    padding: 20px;
    color: var(--color-nav-link);
    text-decoration: none;
  }

  .site-header__link:hover {
    color: var(--color-brand);
  }

  /* Desktop only: below 992px the links sit in the light mobile menu. */
  @media screen and (min-width: 992px) {
    .site-header--dark .site-header__link {
      color: var(--palette-white-smoke);
    }

    .site-header--dark .site-header__link:hover {
      color: var(--color-brand);
    }
  }

  /* In the open mobile menu, dark pages use Webflow's larger, indented menu links. */
  @media screen and (max-width: 991px) {
    .site-header--dark .site-header__link {
      margin-left: 24px;
      color: var(--palette-charcoal);
      font-size: 20px;
      transition: color 0.35s;
    }
  }

  .site-header__menu-actions {
    display: none;
  }

  .site-header__right {
    display: flex;
    align-items: center;
  }

  .site-header__actions {
    display: flex;
    align-items: flex-start;
  }

  .site-header__login,
  .site-header__signup {
    display: inline-block;
    padding: 10px 20px;
    border: 1px solid transparent;
    border-radius: var(--radius-8);
    font-size: 16px;
    font-weight: var(--font-weight-regular);
    text-align: center;
    text-decoration: none;
    transform-style: preserve-3d;
  }

  .site-header__login {
    margin-left: 10px;
    margin-right: 0;
    border-width: 2px;
    background-color: var(--color-button-secondary-bg);
    color: var(--color-button-secondary-text);
    letter-spacing: 0;
    line-height: 18px;
    transition:
      color 0.35s,
      transform 0.3s,
      box-shadow 0.3s,
      background-color 0.3s;
  }

  .site-header__login:hover {
    border-color: var(--color-button-secondary-bg);
    background-color: var(--color-button-hover-bg);
    color: var(--color-button-secondary-bg);
    transform: scale3d(0.96, 0.96, 0.01);
  }

  .site-header__signup {
    margin-left: 20px;
    margin-right: 10px;
    background-color: var(--color-button-primary-bg);
    color: var(--color-button-primary-text);
    letter-spacing: 0;
    line-height: 20px;
    box-shadow: 0 4px 10px #14142b0a;
    transition:
      background-color 0.35s,
      transform 0.35s,
      box-shadow 0.35s,
      color 0.35s,
      border-color 0.35s;
  }

  .site-header__signup:hover {
    border-color: var(--palette-charcoal);
    transform: scale3d(0.96, 0.96, 0.01);
    box-shadow: var(--shadow-button-hover);
  }

  .site-header__menu-button {
    display: none;
  }

  .site-header__menu-icon {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 32px;
    min-height: 24px;
  }

  .site-header__menu-icon span {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 20px;
    background-color: var(--palette-white);
    transition:
      transform 0.3s ease-in-out,
      opacity 0.3s ease-in-out;
  }

  .is-open .site-header__menu-icon span:nth-child(1) {
    transform: translateY(11px) rotate(45deg);
  }

  .is-open .site-header__menu-icon span:nth-child(2) {
    opacity: 0;
  }

  .is-open .site-header__menu-icon span:nth-child(3) {
    transform: translateY(-11px) rotate(-45deg);
  }

  @media screen and (min-width: 1440px) {
    .site-header__container {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media screen and (max-width: 991px) {
    .site-header__logo {
      position: relative;
      z-index: 99;
    }

    .site-header__logo img {
      max-width: none;
    }

    .site-header__right {
      position: relative;
      z-index: 99;
    }

    .site-header__menu {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      max-width: 100vw;
      padding: 160px 24px 32px;
      background-color: var(--color-bg);
      box-shadow: 0 4px 10px #0d0a2c0a;
      visibility: hidden;
      transform: translateX(100%);
      transition:
        transform 0.4s ease-in-out,
        visibility 0s linear 0.4s;
    }

    .is-open .site-header__menu {
      visibility: visible;
      transform: translateX(0);
      transition:
        transform 0.4s ease-in-out,
        visibility 0s;
    }

    .site-header__links {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-header__menu-button {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 56px;
      height: 56px;
      margin-left: 24px;
      padding: 0;
      border-radius: var(--radius-12);
      background-color: var(--palette-charcoal);
      transition:
        transform 0.35s,
        background-color 0.35s;
    }

    .site-header__menu-button:hover {
      transform: scale(0.96);
    }
  }

  @media screen and (max-width: 767px) {
    .site-header {
      padding-top: 24px;
      padding-bottom: 24px;
    }

    .site-header__logo img {
      min-height: 28px;
    }

    .site-header__menu {
      padding-top: 120px;
    }

    .site-header__actions {
      display: none;
    }

    .site-header__right {
      margin-right: 8px;
    }

    .site-header__menu-button {
      margin-left: 10px;
    }

    .site-header__menu-actions {
      display: block;
      width: 100%;
      margin-top: 28px;
      padding-left: 20px;
      padding-right: 20px;
    }

    .site-header__menu-login,
    .site-header__menu-signup {
      display: block;
      padding: 16px 32px;
      border-radius: var(--radius-8);
      font-size: 18px;
      font-weight: var(--font-weight-bold);
      letter-spacing: 1px;
      line-height: 18px;
      text-align: center;
      text-decoration: none;
      white-space: nowrap;
    }

    .site-header__menu-login {
      margin-top: 10px;
      border: 2px solid var(--palette-black);
      box-shadow: 0 4px 10px #14142b0a;
      background-color: var(--color-bg);
      color: var(--palette-black);
      transform-style: preserve-3d;
      transition:
        background-color 0.35s,
        transform 0.35s,
        box-shadow 0.35s,
        color 0.35s,
        border-color 0.35s;
    }

    .site-header__menu-login:hover {
      border-color: var(--palette-charcoal);
      background-color: var(--palette-charcoal);
      color: var(--palette-white);
      transform: scale3d(0.96, 0.96, 0.01);
      box-shadow: var(--shadow-button-hover);
    }

    .site-header__menu-signup {
      margin-top: 20px;
      border: 1px solid transparent;
      border-radius: var(--radius-6);
      background-color: var(--palette-charcoal);
      color: var(--palette-off-white);
      transform-style: preserve-3d;
      transition:
        color 0.35s,
        transform 0.3s,
        box-shadow 0.3s,
        background-color 0.3s;
    }

    .site-header__menu-signup:hover {
      border-color: var(--palette-charcoal);
      transform: scale3d(0.96, 0.96, 0.01);
    }
  }

  @media screen and (max-width: 479px) {
    .site-header__container {
      margin-left: 16px;
      margin-right: 16px;
    }

    .site-header__logo {
      margin-right: 24px;
    }

    .site-header__logo img {
      max-width: 200px;
      min-height: 24px;
      max-height: 42px;
      object-fit: contain;
    }

    .site-header__menu {
      padding-left: 16px;
      padding-right: 16px;
    }

    .site-header__menu-actions {
      padding-left: 10px;
      padding-right: 10px;
    }

    .site-header__menu-login,
    .site-header__menu-signup {
      display: flex;
      justify-content: center;
      width: 100%;
      padding: 12px 20px;
      font-size: 16px;
      letter-spacing: 0.5px;
      line-height: 16px;
    }

    .site-header__menu-button {
      left: 10px;
      width: 44px;
      height: 44px;
      margin-left: 0;
      border-radius: var(--radius-6);
    }

    .site-header__menu-button:hover {
      background-color: var(--palette-black);
    }

    .is-open .site-header__menu-button:hover {
      background-color: var(--palette-charcoal);
    }

    .site-header__menu-icon {
      width: 28px;
      min-height: 20px;
    }

    .is-open .site-header__menu-icon span:nth-child(1) {
      transform: translateY(9px) rotate(45deg);
    }

    .is-open .site-header__menu-icon span:nth-child(3) {
      transform: translateY(-9px) rotate(-45deg);
    }
  }
</style>
