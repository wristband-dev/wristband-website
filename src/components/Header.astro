---
import { LINKS } from '../lib/constants';
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="logo" href="/" aria-label="Wristband home">
      <img src="/images/wristband_logo.svg" alt="Wristband" width="160" height="28" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href={LINKS.docs}>Docs</a>
      <a href="/blog">Blog</a>
      <a href="/pricing">Pricing</a>
      <a href={LINKS.status}>Status</a>
    </nav>
    <div class="nav-actions">
      <a class="btn btn-secondary" href={LINKS.login}>Log In</a>
      <a class="btn btn-primary" href={LINKS.signup}>Sign Up</a>
      <button class="menu-toggle" type="button" aria-label="Toggle menu" id="menu-toggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  toggle?.addEventListener('click', () => {
    header?.classList.toggle('is-open');
  });
</script>
