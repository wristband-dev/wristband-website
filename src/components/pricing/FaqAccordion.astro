---
import Accordion from '../Accordion.astro';

// Frequently asked questions as an accordion, matching live Webflow: each question opens and closes on its own,
// the answer slides open, the arrow turns over and the question turns green.
// Each item (markup, opening and closing) comes from src/components/Accordion.astro. The look is set here.
// Answers are Markdown-style text with [label](url) links, which open in a new tab.
interface Faq {
  id: string;
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;

const escapeHtml = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

// Turns [label](url) links into anchors. Everything else is escaped text.
function answerHtml(answer: string): string {
  return answer
    .split(/(\[[^\]]+\]\([^)]+\))/)
    .map((part) => {
      const link = part.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
      return link ? `<a href="${escapeHtml(link[2])}" target="_blank">${escapeHtml(link[1])}</a>` : escapeHtml(part);
    })
    .join('');
}
---

<div class="faq">
  {faqs.map((faq) => (
    <Accordion id={faq.id} title={faq.question}>
      <p set:html={answerHtml(faq.answer)} />
    </Accordion>
  ))}
</div>

<style>
  @font-face {
    font-family: 'Material Icons';
    src: url('/fonts/material-icons-v145.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: block;
  }

  .faq {
    --accordion-bg: var(--color-bg);
    --accordion-shadow: 0 3px 7px 1px #0000000f;
    --accordion-radius: 10px;
    --accordion-spacing: 30px;

    max-width: 900px;
    margin: 40px auto 0;
    color: var(--color-text);
    text-align: left;
  }
</style>
