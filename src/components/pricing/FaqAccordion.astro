---
// Frequently asked questions as an accordion, matching live Webflow: each question opens and closes on its own,
// the answer slides open, the arrow turns over and the question turns green.
// Opening and closing come from src/lib/accordion.ts. The look is set here. Answers are Markdown-style text with [label](url) links,
// which open in a new tab. Without JavaScript every answer stays open.
interface Faq {
  id: string;
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;

const escapeHtml = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

// Turns [label](url) links into anchors. Everything else is escaped text.
function answerHtml(answer: string): string {
  return answer
    .split(/(\[[^\]]+\]\([^)]+\))/)
    .map((part) => {
      const link = part.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
      return link ? `<a href="${escapeHtml(link[2])}" target="_blank">${escapeHtml(link[1])}</a>` : escapeHtml(part);
    })
    .join('');
}
---

<div class="faq">
  {faqs.map((faq) => (
    <div class="faq__item">
      <div id={faq.id} class="faq__trigger" data-accordion-trigger>
        <h3 class="faq__heading">
          <button
            type="button"
            class="faq__button"
            aria-expanded="true"
            aria-controls={`${faq.id}-answer`}
            set:text={faq.question}
          />
        </h3>
        <span class="faq__icon" aria-hidden="true">
          keyboard_arrow_down
        </span>
      </div>
      <div id={`${faq.id}-answer`} class="faq__content">
        <p set:html={answerHtml(faq.answer)} />
      </div>
    </div>
  ))}
</div>

<script>
  import { initAccordions } from '../../lib/accordion';

  initAccordions();
</script>

<style>
  @font-face {
    font-family: 'Material Icons';
    src: url('/fonts/material-icons-v145.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: block;
  }

  .faq {
    max-width: 900px;
    margin: 40px auto 0;
  }

  .faq__item {
    margin-bottom: 30px;
    padding: 24px 30px 14px;
    border-radius: 10px;
    background-color: var(--color-bg);
    box-shadow: 0 3px 7px 1px #0000000f;
    color: var(--color-text);
    text-align: left;
  }

  .faq__trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }

  .faq__heading {
    flex: 1;
    margin: 0;
    font-size: 20px;
    font-weight: var(--font-weight-medium);
    line-height: 30px;
  }

  .faq__button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: color 0.2s ease-in;
  }

  .faq__trigger.is-open .faq__button {
    color: var(--palette-green);
    transition-timing-function: ease-out;
  }

  .faq__icon {
    color: var(--color-text);
    font-family: 'Material Icons', sans-serif;
    font-size: 32px;
    line-height: 30px;
    font-feature-settings: 'liga';
    /* Webflow's easings: inQuad when closing, outQuad when opening. */
    transition: transform 0.2s cubic-bezier(0.55, 0.085, 0.68, 0.53);
  }

  .faq__trigger.is-open .faq__icon {
    transform: rotate(180deg);
    transition-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .faq__content {
    margin-top: 10px;
    margin-right: 30px;
    overflow: hidden;
  }

  /* With JavaScript on (BaseLayout adds js-reveal before first paint), answers start closed. */
  :global(.js-reveal) .faq__content {
    height: 0;
  }

  @media screen and (max-width: 767px) {
    .faq__content {
      margin-right: 0;
    }
  }
</style>
