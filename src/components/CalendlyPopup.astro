<script>
  // Opens https://calendly.com/wristband… links in Calendly's pop-up widget (loaded on first click)
  // and reports demo_click / generate_lead to GTM via window.dataLayer.
  type CalendlyWindow = Window & {
    dataLayer?: Record<string, unknown>[];
    Calendly?: { initPopupWidget(options: { url: string }): void };
  };

  const win = window as CalendlyWindow;
  const WIDGET_URL = 'https://assets.calendly.com/assets/external/widget';
  const LOAD_TIMEOUT_MS = 3000;
  let widgetRequested = false;
  let widgetFailed = false;
  let opening = false;

  function track(data: Record<string, unknown>) {
    win.dataLayer = win.dataLayer || [];
    win.dataLayer.push(data);
  }

  // Resolves true once window.Calendly exists, false if it is not there within LOAD_TIMEOUT_MS.
  function loadWidget(): Promise<boolean> {
    if (!widgetRequested) {
      widgetRequested = true;
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = `${WIDGET_URL}.css`;
      const js = document.createElement('script');
      js.src = `${WIDGET_URL}.js`;
      js.async = true;
      document.head.append(css, js);
    }
    const started = Date.now();
    return new Promise((resolve) => {
      (function poll() {
        if (win.Calendly) resolve(true);
        else if (widgetFailed || Date.now() - started >= LOAD_TIMEOUT_MS) resolve(false);
        else setTimeout(poll, 50);
      })();
    });
  }

  // Fallback: follow the link the way the browser would have.
  function followLink(link: HTMLAnchorElement) {
    if (link.target === '_blank') {
      const tab = window.open(link.href, '_blank');
      if (tab) {
        tab.opener = null;
        return;
      }
    }
    window.location.href = link.href;
  }

  document.addEventListener('click', async (event) => {
    const link =
      event.target instanceof Element
        ? event.target.closest<HTMLAnchorElement>('a[href^="https://calendly.com/wristband"]')
        : null;
    if (!link || event.defaultPrevented) return;

    track({ event: 'demo_click', link_url: link.href, cta_location: location.pathname });
    // Modified clicks (open in new tab/window) keep the normal link behavior.
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    if (opening) return;

    opening = true;
    const ready = await loadWidget();
    opening = false;
    if (ready) {
      win.Calendly?.initPopupWidget({ url: link.href });
    } else {
      widgetFailed = true;
      followLink(link);
    }
  });

  window.addEventListener('message', (event) => {
    if (event.origin === 'https://calendly.com' && event.data?.event === 'calendly.event_scheduled') {
      track({ event: 'generate_lead', lead_type: 'calendly' });
    }
  });
</script>
