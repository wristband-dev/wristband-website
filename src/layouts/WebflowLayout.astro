---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  wfPage: string;
  wfSite?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'Easily build multi-tenant auth flows for your SaaS applications using our comprehensive set of hosted pages and APIs.',
  ogImage = 'https://cdn.prod.website-files.com/64d01a3671d020746e331a42/6747c1786763c41e452b21c4_hero_background.webp',
  wfPage,
  wfSite = '64d01a3671d020746e331a42',
  bodyClass = 'body',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.wristband.dev').href;
---

<!doctype html>
<html
  data-wf-domain="www.wristband.dev"
  data-wf-page={wfPage}
  data-wf-site={wfSite}
  lang="en"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="stylesheet" href="/css/webflow.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js"></script>
    <script is:inline>
      WebFont.load({
        google: {
          families: [
            'Inter:300,400,500,600,700',
            'JetBrains Mono:300,400,500,600,700',
            'Material Icons:300,400,500,600,700',
            'Roboto:300,400,500,600,700',
          ],
        },
      });
    </script>
    <script is:inline>
      !(function (o, c) {
        var n = c.documentElement,
          t = ' w-mod-';
        n.className += t + 'js';
        ('ontouchstart' in o || (o.DocumentTouch && c instanceof DocumentTouch)) &&
          (n.className += t + 'touch');
      })(window, document);
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-KQNQ4T3V');
    </script>

    <style is:global>
      /* Preserve Webflow look; hide Webflow badge if injected */
      .w-webflow-badge {
        display: none !important;
      }
    </style>
  </head>
  <body class={bodyClass}>
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-KQNQ4T3V"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>

    <slot />

    <script
      is:inline
      src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=64d01a3671d020746e331a42"
      type="text/javascript"
      integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
      crossorigin="anonymous"></script>
    <script is:inline src="/js/webflow.schunk.3.js" type="text/javascript"></script>
    <script is:inline src="/js/webflow.schunk.1.js" type="text/javascript"></script>
    <script is:inline src="/js/webflow.schunk.2.js" type="text/javascript"></script>
    <script is:inline src="/js/webflow.js" type="text/javascript"></script>
    <!-- SDK matrix (mounts into #wristband-sdk-matrix) — needs React globals first -->
    <script
      is:inline
      src="https://unpkg.com/react@18.3.1/umd/react.production.min.js"
      crossorigin="anonymous"></script>
    <script
      is:inline
      src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js"
      crossorigin="anonymous"></script>
    <script
      is:inline
      src="https://assets.wristband.dev/corp-site/webflow/components/sdk-matrix/1.2.1/wristband-sdk-matrix.js"
    ></script>

    <!-- Crisp -->
    <script is:inline>
      window.$crisp = [];
      window.CRISP_WEBSITE_ID = '5d9c651e-6a02-41be-9102-aa164316299e';
      (function () {
        d = document;
        s = d.createElement('script');
        s.src = 'https://client.crisp.chat/l.js';
        s.async = 1;
        d.getElementsByTagName('head')[0].appendChild(s);
      })();
    </script>

    <!-- Termly -->
    <script
      is:inline
      type="text/javascript"
      src="https://app.termly.io/resource-blocker/f2dcecf0-7035-44c5-bf2c-cfd99f36bc09?autoBlock=on"
    ></script>
    <script is:inline type="text/javascript" src="https://app.termly.io/embed-policy.min.js"></script>
  </body>
</html>
