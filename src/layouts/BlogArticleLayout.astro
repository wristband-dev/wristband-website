---
// Layout for blog posts written in Markdown or MDX (src/content/blog).
// Built on BaseLayout, with no Webflow CSS or scripts. Matches the copied Webflow blog posts:
// category badge, title, summary and cover image, then the article and the author card.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import AuthorCard from '../components/blog/AuthorCard.astro';
import type { Author } from '../data/blog/authors';
import type { JsonLdNode } from '../lib/seo';

interface Props {
  title: string;
  summary?: string;
  category: string;
  /** Cover image: an imported image (optimized by Astro) or a public URL. */
  cover: ImageMetadata | string;
  ogImage?: string;
  jsonLd?: JsonLdNode[];
  datePublished?: Date | string;
  author?: Author;
}

const { title, summary, category, cover, ogImage, jsonLd, datePublished, author } = Astro.props;
---

<BaseLayout
  title={title}
  description={summary || undefined}
  ogImage={ogImage}
  ogType="article"
  datePublished={datePublished}
  jsonLd={jsonLd}
>
  <div class="post-hero">
    <div class="post-hero__container">
      <div class="post-hero__inner">
        <div class="post-hero__text">
          <div class="post-hero__badge-wrap" data-reveal>
            <a href="/blog" class="post-hero__badge">
              {category}
            </a>
          </div>
          <h1 class="post-hero__title" data-reveal="300">
            {title}
          </h1>
          {summary && (
            <div class="post-hero__summary-wrap">
              <p class="post-hero__summary" data-reveal="400">
                {summary}
              </p>
            </div>
          )}
        </div>
        <div class="post-hero__cover">
          {typeof cover === 'string' ? (
            <img src={cover} alt={title} class="post-hero__cover-img" data-reveal="500" />
          ) : (
            <Image
              src={cover}
              alt={title}
              widths={[500, 800, 1080, 1600, 2000]}
              sizes="(max-width: 1059px) 100vw, 1020px"
              loading="eager"
              class="post-hero__cover-img"
              data-reveal="500"
            />
          )}
        </div>
      </div>
    </div>
  </div>

  <div class="post-body">
    <div class="post-body__container">
      <div data-reveal>
        <div class="post-article">
          <slot />
        </div>
        {author && <AuthorCard author={author} />}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Adds a copy button to each code block in the article, except ```text blocks, which show command output.
  const COPY_ICON =
    '<svg class="code-block__icon-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/><path d="M10.5 5.5V3.5a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"/></svg>';
  const DONE_ICON =
    '<svg class="code-block__icon-done" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8.5l3 3 7-7"/></svg>';

  for (const pre of document.querySelectorAll<HTMLPreElement>('.post-article pre:not([data-language="text"])')) {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);
    wrapper.append(pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-block__copy';
    button.setAttribute('aria-label', 'Copy code');
    button.innerHTML = COPY_ICON + DONE_ICON;
    wrapper.append(button);

    let timer: number | undefined;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
      } catch {
        return;
      }
      button.classList.add('is-copied');
      button.setAttribute('aria-label', 'Copied');
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.classList.remove('is-copied');
        button.setAttribute('aria-label', 'Copy code');
      }, 2000);
    });
  }
</script>

<style>
  /* Header area: badge, title, summary and cover image */
  .post-hero,
  .post-body {
    position: relative;
    margin: 0 10px 20px;
    padding-top: 100px;
    padding-bottom: 0;
    background-color: var(--color-bg);
  }

  .post-hero__container {
    max-width: var(--container-header-max);
    margin-left: 20px;
    margin-right: 20px;
  }

  .post-hero__inner {
    max-width: 1020px;
    margin-left: auto;
    margin-right: auto;
  }

  .post-hero__text {
    text-align: center;
  }

  .post-hero__badge-wrap {
    margin-bottom: 16px;
  }

  .post-hero__badge {
    display: inline-block;
    padding: 16px 30px;
    border-radius: var(--radius-12);
    background-color: var(--color-brand);
    color: var(--color-on-brand);
    text-decoration: none;
    transform-style: preserve-3d;
    transition:
      transform 0.35s,
      background-color 0.35s;
  }

  .post-hero__badge:hover {
    background-color: #3635c0;
    color: var(--color-on-brand);
    transform: scale3d(0.96, 0.96, 0.1);
  }

  .post-hero__summary-wrap {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  /* Left-aligned inside the centered column, like live Webflow. */
  .post-hero__summary {
    margin: 0 auto;
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.5em;
    text-align: left;
  }

  .post-hero__cover {
    position: relative;
    margin-top: 80px;
    overflow: hidden;
    border-radius: var(--radius-24);
    transform: translate(0);
  }

  .post-hero__cover-img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 800px;
    object-fit: cover;
  }

  /* Article */
  /* flow-root keeps the author card's bottom margin inside, like Webflow's container. */
  .post-body__container {
    display: flow-root;
    max-width: 848px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  /* flow-root keeps the last paragraph's bottom margin inside the article, like Webflow's rich text. */
  .post-article {
    display: flow-root;
    color: var(--color-text);
  }

  .post-article :global(h1) {
    font-weight: var(--font-weight-semibold);
  }

  .post-article :global(h2) {
    margin-top: 40px;
    font-weight: var(--font-weight-semibold);
  }

  .post-article :global(h3) {
    margin-top: 32px;
    font-weight: var(--font-weight-semibold);
  }

  /* Webflow's default h4, bold text and inline code color, which the copied posts show. */
  .post-article :global(h4),
  .post-article :global(strong),
  .post-article :global(:not(pre) > code) {
    color: var(--color-text-emphasis);
  }

  .post-article :global(ul),
  .post-article :global(ol) {
    margin-bottom: 40px;
    overflow: hidden;
  }

  .post-article :global(li) {
    margin-bottom: 8px;
  }

  .post-article :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 28px;
  }

  .post-article :global(figure) {
    margin-top: 48px;
  }

  /*
    Code blocks: colors come from src/lib/code-theme.mjs (matching the docs portal).
    The copy button is added by the script at the bottom of this file.
  */
  .post-article :global(.code-block) {
    position: relative;
    margin: 0 0 20px;
  }

  .post-article :global(pre) {
    margin: 0 0 20px;
    padding: 20px 24px;
    overflow-x: auto;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.7;
  }

  .post-article :global(.code-block pre) {
    margin: 0;
    padding-right: 64px;
  }

  .post-article :global(.code-block__copy) {
    display: flex;
    position: absolute;
    top: 12px;
    right: 12px;
    justify-content: center;
    align-items: center;
    width: 32px;
    height: 28px;
    padding: 0;
    border: 1px solid #4a4b4c;
    border-radius: 4px;
    background-color: #2e2f30;
    color: #c8c8c8;
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .post-article :global(.code-block__copy:hover),
  .post-article :global(.code-block__copy:focus-visible) {
    border-color: #8a8b8c;
    color: #ffffff;
  }

  .post-article :global(.code-block__copy svg) {
    width: 16px;
    height: 16px;
  }

  .post-article :global(.code-block__copy .code-block__icon-done),
  .post-article :global(.code-block__copy.is-copied .code-block__icon-copy) {
    display: none;
  }

  .post-article :global(.code-block__copy.is-copied .code-block__icon-done) {
    display: block;
  }

  .post-article :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  @media screen and (min-width: 1440px) {
    .post-hero__container {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media screen and (max-width: 991px) {
    .post-hero,
    .post-body {
      padding-top: 80px;
    }

    .post-hero__cover {
      margin-top: 48px;
      border-radius: var(--radius-16);
    }
  }

  @media screen and (max-width: 767px) {
    .post-hero,
    .post-body {
      padding-top: 56px;
    }

    .post-hero__badge {
      padding: 10px 22px;
      border-radius: 10px;
    }

    .post-hero__cover {
      margin-top: 32px;
      border-radius: var(--radius-12);
    }

    .post-hero__cover-img {
      min-height: 26vh;
    }

    .post-article :global(ul),
    .post-article :global(ol) {
      padding-left: 24px;
    }

    .post-article :global(img) {
      border-radius: 16px;
    }

    .post-article :global(figure) {
      margin-top: 40px;
      margin-bottom: 40px;
    }

    .post-article :global(h5),
    .post-article :global(h6) {
      margin-bottom: 8px;
    }
  }

  @media screen and (max-width: 479px) {
    /* Webflow's header adds 60px of space below itself at this width. */
    .post-hero {
      margin-top: 60px;
    }

    .post-hero__container {
      margin-left: 16px;
      margin-right: 16px;
    }

    .post-body__container {
      padding-left: 16px;
      padding-right: 16px;
    }

    .post-hero__cover-img {
      min-height: 20vh;
    }
  }
</style>
