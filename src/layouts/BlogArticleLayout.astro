---
import WebflowLayout from './WebflowLayout.astro';
import { BLOG_POST_WF_PAGE } from '../lib/blog';
import { getWebflowChrome } from '../lib/webflow';

import type { JsonLdNode } from '../lib/seo';

interface Props {
  title: string;
  summary?: string;
  category: string;
  coverImage: string;
  ogImage?: string;
  jsonLd?: JsonLdNode[];
  publishedTime?: Date | string;
}

const { title, summary, category, coverImage, ogImage, jsonLd, publishedTime } = Astro.props;

const { headerHtml, footerHtml } = getWebflowChrome();
---

<WebflowLayout
  title={title}
  description={summary || undefined}
  ogImage={ogImage}
  ogType="article"
  publishedTime={publishedTime}
  jsonLd={jsonLd}
  wfPage={BLOG_POST_WF_PAGE}
  bodyClass="body"
>
  <div class="page-wrapper">
    <Fragment set:html={headerHtml} />
    <div class="section blog-post">
      <div class="container-header w-container">
        <div class="inner-container-1020px">
          <div class="text-center">
            <div class="mg-bottom-16px">
              <a href="/blog" class="badge w-inline-block"><div>{category}</div></a>
            </div>
            <h1 class="heading-10">{title}</h1>
            {
              summary && (
                <div class="inner-container-600px align-center">
                  <p class="mg-bottom-0px">{summary}</p>
                </div>
              )
            }
          </div>
          <div class="image-wrapper basic-frame---large mg-top-large-80px">
            <img src={coverImage} alt={title} class="image post-hero" />
          </div>
        </div>
      </div>
    </div>
    <div class="bg blog-post"></div>
  </div>
  <div class="section blog-post">
    <div class="container-medium w-container">
      <div class="rich-text w-richtext mdx-article">
        <slot />
      </div>
    </div>
  </div>
  <Fragment set:html={footerHtml} />
</WebflowLayout>

<style is:global>
  .mdx-article img {
    max-width: 100%;
    height: auto;
  }

  .mdx-article pre {
    margin: 1.5em 0;
    border-radius: 8px;
    overflow-x: auto;
  }

  .mdx-article :not(pre) > code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.9em;
  }
</style>
